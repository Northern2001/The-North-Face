rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function ownerUid() {
      // Thay YOUR_OWNER_FIREBASE_UID bằng UID tài khoản owner (Auth > Users)
      return "yfjxrdfFVdeSoXBBFcFMk93sy0Q2";
    }

    function isOwner() {
      return request.auth != null && request.auth.uid == ownerUid();
    }

    function isVisitor(convId) {
      return request.auth != null && request.auth.uid == convId;
    }

    function validMessage() {
      return request.resource.data.keys().hasAll(["text", "sender", "createdAt"])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 4000
        && request.resource.data.sender is string
        && request.resource.data.createdAt is timestamp;
    }

    match /inbox/{convId} {
      allow read: if isOwner() || isVisitor(convId);

      allow create: if isVisitor(convId)
        && request.resource.data.keys().hasAll(["updatedAt", "preview"])
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.preview is string;

      allow update: if isOwner() || isVisitor(convId);

      match /messages/{msgId} {
        allow read: if isOwner() || isVisitor(convId);

        allow create: if validMessage() && (
          (isVisitor(convId) && request.resource.data.sender == "visitor")
          || (isOwner() && request.resource.data.sender == "owner")
        );
      }
    }
  }
}
