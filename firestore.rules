rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Trùng UID chủ trang (Auth) và ownerAuthUid trong js/firebase-config.js
    function configuredOwnerUid() {
      return "yfjxrdfFVdeSoXBBFcFMk93sy0Q2";
    }

    function isVisitorForConv(convId) {
      return request.auth != null && request.auth.uid == convId;
    }

    function validMessage() {
      return request.resource.data.keys().hasAll(["text", "sender", "createdAt"])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 4000
        && request.resource.data.sender is string;
    }

    // Đọc: chỉ dưới owners/<UID đã cấu hình>, và (đang đăng nhập đúng chủ HOẶC là khách của conv đó)
    function canReadChat(ownerUid, convId) {
      return request.auth != null
        && ownerUid == configuredOwnerUid()
        && (request.auth.uid == ownerUid || request.auth.uid == convId);
    }

    function isOwnerSignedIn() {
      return request.auth != null && request.auth.uid == configuredOwnerUid();
    }

    match /owners/{ownerUid}/chats/{convId} {
      allow read: if canReadChat(ownerUid, convId);

      allow create: if ownerUid == configuredOwnerUid()
        && isVisitorForConv(convId)
        && request.resource.data.keys().hasAll(["updatedAt", "preview"])
        && request.resource.data.preview is string;

      allow update: if ownerUid == configuredOwnerUid()
        && (isOwnerSignedIn() || isVisitorForConv(convId));

      match /messages/{msgId} {
        allow read: if canReadChat(ownerUid, convId);

        allow create: if ownerUid == configuredOwnerUid() && validMessage() && (
          (isVisitorForConv(convId) && request.resource.data.sender == "visitor")
          || (isOwnerSignedIn() && request.resource.data.sender == "owner")
        );
      }
    }
  }
}
